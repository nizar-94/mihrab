{
  "name": "mihrab",
  "version": "1.4.1",
  "description": "A Windows system-tray app that shows a random or sequential Quran verse as a custom desktop notification on a schedule you choose. Fully offline, no accounts, no telemetry.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nizar-94/mihrab.git"
  },
  "keywords": [
    "quran",
    "electron",
    "tray-app",
    "islam",
    "reminder",
    "notification",
    "offline"
  ],
  "author": "Nizar Hawawreh",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/nizar-94/mihrab/issues"
  },
  "homepage": "https://github.com/nizar-94/mihrab#readme",
  "dependencies": {
    "adhan": "^4.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
